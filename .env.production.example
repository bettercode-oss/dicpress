# 이 파일을 서버에 .env.production 으로 복사하고 실제 값으로 채우세요.
# 절대 Git에 커밋하지 마세요.

# 사이트 정보 (빌드 시 번들에 포함됨 — 변경 시 재빌드 필요)
NEXT_PUBLIC_SITE_URL="https://your-domain.example.com"
NEXT_PUBLIC_SITE_NAME="your-domain.example.com"

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dic_bizos?schema=public"

# openssl rand -base64 32 로 생성
NEXTAUTH_SECRET="your-strong-random-secret-here"
NEXTAUTH_URL="https://your-domain.example.com"

# WebAuthn / Passkey
WEBAUTHN_RP_ID="your-domain.example.com"
WEBAUTHN_RP_NAME="사이트 이름"
WEBAUTHN_ORIGIN="https://your-domain.example.com"

# Resend 이메일 발송
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM="noreply@bizos.kr"   # Resend에서 인증된 도메인의 주소여야 함

# 관리자 콘솔(admin.bizos.kr)이 서버 간 호출에 쓰는 토큰
# openssl rand -base64 48 로 생성. 콘솔의 DICPRESS_SERVICE_TOKEN 과 같은 값이어야 한다.
# ⚠️ 이 토큰을 쥐면 X-Actor-Email 로 누구든 사칭할 수 있다. nginx 가 클라이언트발
#    Authorization 을 비우고, 콘솔은 루프백(127.0.0.1)으로 부른다는 전제 위에 있다.
ADMIN_SERVICE_TOKEN="generate-with-openssl-rand-base64-48"
