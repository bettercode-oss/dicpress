# 로컬 개발용 예시. 이 파일은 커밋된다 — 실제 값을 넣지 말 것.
# 값을 채워 `.env` 로 복사한다. 프로덕션 서버는 `.env.production.example` 을 쓴다.
#
# 콘솔(admin.bizos.kr)을 로컬에서 함께 띄우는 방법은 저쪽 저장소의
# `docs/local-development.md` 에 있다. 이 앱은 로컬에서 **3000 번**으로 돈다
# (`next dev` 기본값). 프로덕션 루프백 포트인 3001 이 아니다.

# --- 사이트 ---
# 내부 링크 판별에 쓴다. 로컬에서는 localhost 여야 자기 링크를 내부로 본다.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="dicpress (local)"

# --- DB ---
# 로컬에 만든 PostgreSQL. 프로덕션 DB 를 가리키지 말 것.
DATABASE_URL="postgresql://<user>@localhost:5432/dic_bizos?schema=public"

# --- NextAuth ---
# openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# --- WebAuthn / Passkey ---
# ⚠️ RP_ID 는 접속 도메인과 일치해야 한다. 로컬에서는 localhost 다.
#    프로덕션 값(dic.bizos.kr)을 넣으면 등록·인증이 모두 실패한다.
#
# ⚠️ RP ID 에는 **포트가 들어가지 않는다.** 콘솔도 로컬에서는 같은 `localhost` 라
#    두 앱의 패스키가 로컬에서만 한 RP 에 섞인다. 프로덕션에서는
#    dic.bizos.kr 과 admin.bizos.kr 이 서로 다른 RP 다.
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="dicpress (local)"
WEBAUTHN_ORIGIN="http://localhost:3000"

# --- 이메일 (선택) ---
# 비워 두면 발송이 실패하지만 승인 처리 자체는 완료된다(#58) — 로컬에서는 대개 비워 둔다.
RESEND_API_KEY=
RESEND_FROM=

# --- 관리자 콘솔 커넥터 ---
# 콘솔의 DICPRESS_SERVICE_TOKEN 과 **같은 값**이어야 한다.
# ⚠️ 프로덕션 토큰을 복사해 오지 말 것. 로컬 전용 값을 새로 만든다:
#      openssl rand -base64 48
#    이 토큰을 쥐면 X-Actor-Email 로 누구든 사칭할 수 있다. 프로덕션에서는 nginx 가
#    클라이언트발 Authorization 을 비우는 것이 유일한 실질 경계인데, **로컬에는 그 방어가
#    없다** — 로컬 값과 프로덕션 값을 분리해 두는 이유다.
ADMIN_SERVICE_TOKEN=

# --- seed 용 (npm run db:seed) ---
# 로컬 첫 계정. 콘솔에서 dicpress 를 부를 때 쓸 이메일과 맞추면 편하다 —
# 콘솔 로그인 이메일과 같게 두면 DICPRESS_ACTOR_EMAIL 탈출구 없이 돌릴 수 있다.
# ⚠️ 지금 seed 는 role 을 주지 않아 AUTHOR 로 만들어진다. OWNER 전용 기능
#    (역할 변경·계정 삭제)을 로컬에서 보려면 만든 뒤 DB 에서 role 을 OWNER 로 바꾼다.
#    seed 자체를 고치는 일은 #67 에 있다.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- 업로드 경로 (로컬은 비워 둔다) ---
# 비우면 <cwd>/public/uploads 로 떨어지고 next dev 가 그대로 서빙한다.
# 프로덕션에서만 절대 경로가 필요하다 — 이유는 .env.production.example 과 #90 참고.
UPLOAD_DIR=
