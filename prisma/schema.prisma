generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  AUTHOR
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id          String               @id @default(cuid())
  email       String               @unique
  password    String?
  name        String?
  role        UserRole             @default(AUTHOR)
  status      UserStatus           @default(ACTIVE)
  createdAt   DateTime             @default(now())
  documents   Document[]
  credentials WebAuthnCredential[]
}

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt
  deviceType   String?
  backedUp     Boolean  @default(false)
  transports   String?
  createdAt    DateTime @default(now())
}

enum AccountRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AccountRequest {
  id          String               @id @default(cuid())
  email       String               @unique
  name        String?
  status      AccountRequestStatus @default(PENDING)
  requestedAt DateTime             @default(now())
  resolvedAt  DateTime?
}

model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  email     String
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Document {
  id           String            @id @default(cuid())
  title        String
  slug         String            @unique
  summary      String?
  contentMd    String            @db.Text
  contentHtml  String?           @db.Text
  status       DocumentStatus    @default(DRAFT)
  thumbnailUrl String?
  authorId     String
  author       User              @relation(fields: [authorId], references: [id])
  publishedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  versions     DocumentVersion[]
  tags         DocumentTag[]
  mediaAssets  MediaAsset[]
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  contentMd   String   @db.Text
  contentHtml String?  @db.Text
  versionNo   Int
  createdAt   DateTime @default(now())
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  documents DocumentTag[]
}

model DocumentTag {
  documentId String
  tagId      String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
}

model MediaAsset {
  id         String    @id @default(cuid())
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  url        String
  fileName   String
  fileType   String
  fileSize   Int?
  uploadedAt DateTime  @default(now())
}

/**
 * 쓰기 요청의 감사 기록 (#103).
 *
 * ## 왜 로그가 아니라 테이블인가
 *
 * PM2 로그는 회전되고 유실되며 검색이 어렵다. 감사 기록의 쓸모는 **사후에 찾을 수 있다는
 * 것**뿐이라, 찾기 어려우면 없는 것과 같다. 대신 전량을 테이블에 넣지는 않는다 —
 * 읽기까지 남기면 행이 폭증하고 정작 중요한 변경이 묻힌다. 그래서 **쓰기만** 남긴다.
 *
 * ## User 와 관계를 맺지 않는다
 *
 * `actorId` 는 문자열일 뿐 외래 키가 아니다. 계정이 삭제돼도 **그 사람이 무엇을 했는지는
 * 남아야 하기 때문**이다. 관계를 걸면 삭제가 기록을 함께 지우거나(Cascade) 지운 사람을
 * 알 수 없게 만든다(SetNull). 이메일·역할도 그 시점 값으로 복사해 둔다.
 */
model AuditLog {
  id     String   @id @default(cuid())
  at     DateTime @default(now())

  /** 그 시점의 주체. User 삭제와 무관하게 남기려고 관계 없이 값만 복사한다. */
  actorId    String
  actorEmail String
  actorRole  UserRole

  /** 세션으로 들어왔는지 서비스 토큰(콘솔)으로 들어왔는지. */
  source String

  method String
  /** 쿼리스트링은 제외한 경로. 값이 섞여 들어오는 것을 막는다. */
  path   String

  @@index([at])
  @@index([actorId, at])
}
