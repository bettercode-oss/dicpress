# /etc/nginx/sites-available/${DOMAIN}
# 이 파일은 템플릿입니다. setup.sh 가 envsubst 로 실제 conf 를 생성합니다.
# 직접 편집하지 말고 deploy/project.conf 의 값을 수정하세요.

server {
    listen 80;
    server_name ${DOMAIN};
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${DOMAIN};

    # SSL — certbot 등으로 발급 후 경로 지정
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # 업로드 본문 크기 — 기본값 1m 이면 앱이 허용하는 5MB 이미지가 413 으로 잘린다
    client_max_body_size 10m;

    # 업로드 파일 직접 서빙 (Nginx가 Node.js 없이 처리)
    #
    # ⚠️ ${UPLOAD_DIR} 은 앱의 UPLOAD_DIR 환경변수와 **같은 값이어야 한다** (#90).
    # 예전에는 여기가 ${DEPLOY_PATH}/public/uploads/ 였는데, standalone 서버가 자기
    # 디렉터리로 chdir 하는 바람에 앱은 .next/standalone/public/uploads/ 에 쓰고 있었다.
    # 업로드는 201 인데 그 URL 은 404 였고, 그 자리는 배포마다 비워졌다.
    location /uploads/ {
        alias ${UPLOAD_DIR}/;
        expires 30d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options nosniff;
    }

    # Next.js 정적 파일 직접 서빙
    location /_next/static/ {
        alias ${DEPLOY_PATH}/.next/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ⚠️ 프록시하는 location 을 새로 추가할 때 반드시 읽을 것
    #
    # nginx 의 proxy_set_header 는 **상속이 아니라 치환**이다. 어떤 블록에
    # proxy_set_header 가 하나라도 있으면 상위 레벨의 것을 **전부 버린다.**
    # 그리고 형제 location 끼리는 애초에 상속 관계가 없다.
    #
    # 즉 아래처럼 새 블록을 만들면 Authorization 이 그대로 앱까지 흘러가고,
    # Host·X-Forwarded-* 도 함께 사라진다. 보안 경계가 조용히 뚫린다.
    #
    #     location /api/ {
    #         proxy_pass http://127.0.0.1:${PORT};
    #         proxy_set_header X-Something foo;   # ← 이 한 줄이 아래 전부를 무효화한다
    #     }
    #
    # 그래서 목록을 파일 하나로 뺐다 — deploy/nginx-proxy-headers.conf 가
    # /etc/nginx/snippets/dicpress-proxy.conf 로 설치되고, **프록시하는 모든 블록이
    # 그것을 include 한다.** 새 블록을 만들 때 복사하지 말고 include 를 쓸 것.
    # 파일이 없으면 nginx -t 가 크게 실패하므로 조용히 어긋나지 않는다.
    #
    # 살아 있는지는 scripts/verify-auth-boundary.sh 가 배포마다 확인한다.

    # ── 인증 관련 경로: 속도 제한을 건다 (#104) ──────────────────────────────
    #
    # 이 경로들은 로그인하지 않고도 이메일 하나로 계정 존재 여부를 알려 준다.
    # 표면을 없애는 대신 **대량 조회만 비싸게** 만든다. 근거와 숫자는
    # deploy/nginx-rate-limit.conf 에 있다.
    #
    # ⚠️ 아래 두 블록은 `location /` 보다 **더 긴 접두사**라 nginx 가 이쪽을 먼저 고른다.
    #    파일 안의 순서와는 무관하다(최장 접두사 우선).

    location ^~ /api/auth/webauthn/ {
        limit_req zone=dic_auth burst=20 nodelay;
        proxy_pass http://127.0.0.1:${PORT};
        include    /etc/nginx/snippets/dicpress-proxy.conf;
    }

    location = /api/admin/signup {
        limit_req zone=dic_auth burst=20 nodelay;
        proxy_pass http://127.0.0.1:${PORT};
        include    /etc/nginx/snippets/dicpress-proxy.conf;
    }

    # 나머지 요청은 Next.js standalone 서버로 프록시
    location / {
        proxy_pass http://127.0.0.1:${PORT};
        include    /etc/nginx/snippets/dicpress-proxy.conf;
    }

    # 로그
    access_log /var/log/nginx/${DOMAIN}.access.log;
    error_log  /var/log/nginx/${DOMAIN}.error.log;
}
