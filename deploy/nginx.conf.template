# /etc/nginx/sites-available/${DOMAIN}
# 이 파일은 템플릿입니다. setup.sh 가 envsubst 로 실제 conf 를 생성합니다.
# 직접 편집하지 말고 deploy/project.conf 의 값을 수정하세요.

server {
    listen 80;
    server_name ${DOMAIN};
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${DOMAIN};

    # SSL — certbot 등으로 발급 후 경로 지정
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # 업로드 본문 크기 — 기본값 1m 이면 앱이 허용하는 5MB 이미지가 413 으로 잘린다
    client_max_body_size 10m;

    # 업로드 파일 직접 서빙 (Nginx가 Node.js 없이 처리)
    location /uploads/ {
        alias ${DEPLOY_PATH}/public/uploads/;
        expires 30d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options nosniff;
    }

    # Next.js 정적 파일 직접 서빙
    location /_next/static/ {
        alias ${DEPLOY_PATH}/.next/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 나머지 요청은 Next.js standalone 서버로 프록시
    location / {
        proxy_pass         http://127.0.0.1:${PORT};

        # 클라이언트가 보낸 Authorization 을 버린다.
        #
        # 이 앱은 브라우저에서 Authorization 헤더를 한 번도 쓰지 않는다 — 관리자 UI 는
        # 전부 세션 쿠키다. 반면 서버 간 호출(admin.bizos.kr 콘솔)은 이 헤더에
        # ADMIN_SERVICE_TOKEN 을 실어 보내고, 그 토큰을 쥔 쪽은 X-Actor-Email 로
        # 아무나 사칭할 수 있다.
        #
        # 여기서 헤더를 비우면 토큰 경로가 공개 인터넷에서 물리적으로 도달 불가능해지고,
        # 루프백(127.0.0.1:${PORT})으로 들어오는 콘솔에서만 살아 있다.
        # 지우면 토큰이 인터넷에 노출된다.
        proxy_set_header   Authorization     "";
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        'upgrade';
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }

    # 로그
    access_log /var/log/nginx/${DOMAIN}.access.log;
    error_log  /var/log/nginx/${DOMAIN}.error.log;
}
